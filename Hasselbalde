    <!-- INTERACTIVE EMBEDDED JAVASCRIPT -->
    <script>
        // 1. Mobile Menu Toggle
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // 2. Three.js Interactive Viewport Initialization
        const container = document.getElementById('threeCanvas');
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
        camera.position.set(0, 1.2, 4.5);

        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(container.clientWidth, container.clientHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        container.appendChild(renderer.domElement);

        // Lighting setup
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
        scene.add(ambientLight);

        const mainLight = new THREE.DirectionalLight(0xd4af37, 1.5);
        mainLight.position.set(5, 5, 5);
        scene.add(mainLight);

        // Hasselblad Camera Body Group
        const cameraGroup = new THREE.Group();
        
        // Materials
        let isWireframe = false;
        const bodyMat = new THREE.MeshPhysicalMaterial({ color: 0x141416, metalness: 0.85, roughness: 0.2, wireframe: isWireframe });
        const goldMat = new THREE.MeshStandardMaterial({ color: 0xd4af37, metalness: 0.9, roughness: 0.15, wireframe: isWireframe });
        const glassMat = new THREE.MeshPhysicalMaterial({ color: 0xffffff, transmission: 0.9, opacity: 1, transparent: true, roughness: 0.05 });

        // Body Mesh
        const bodyGeo = new THREE.BoxGeometry(2.2, 1.6, 1.0);
        const bodyMesh = new THREE.Mesh(bodyGeo, bodyMat);
        cameraGroup.add(bodyMesh);

        // Top Cap
        const capGeo = new THREE.CylinderGeometry(0.6, 0.8, 0.4, 32);
        const capMesh = new THREE.Mesh(capGeo, goldMat);
        capMesh.position.set(0, 0.9, 0);
        cameraGroup.add(capMesh);

        // Lens Mount Ring
        const ringGeo = new THREE.TorusGeometry(0.65, 0.06, 16, 64);
        const ringMesh = new THREE.Mesh(ringGeo, goldMat);
        ringMesh.position.set(0, 0, 0.52);
        cameraGroup.add(ringMesh);

        // Lens Barrel
        const lensGeo = new THREE.CylinderGeometry(0.62, 0.62, 1.2, 64);
        lensGeo.rotateX(Math.PI / 2);
        const lensMesh = new THREE.Mesh(lensGeo, bodyMat);
        lensMesh.position.set(0, 0, 0.6);
        cameraGroup.add(lensMesh);

        // Front Glass Element
        const glassGeo = new THREE.SphereGeometry(0.55, 32, 16, 0, Math.PI * 2, 0, Math.PI / 4);
        glassGeo.rotateX(Math.PI / 2);
        const glassMesh = new THREE.Mesh(glassGeo, glassMat);
        glassMesh.position.set(0, 0, 1.15);
        cameraGroup.add(glassMesh);

        scene.add(cameraGroup);

        // Rotation & Interactivity
        let autoRotate = true;
        function animate() {
            requestAnimationFrame(animate);
            if (autoRotate) {
                cameraGroup.rotation.y += 0.005;
            }
            renderer.render(scene, camera);
        }
        animate();

        // Control buttons
        document.getElementById('toggleWireframe').addEventListener('click', () => {
            isWireframe = !isWireframe;
            bodyMat.wireframe = isWireframe;
            goldMat.wireframe = isWireframe;
        });

        document.getElementById('toggleRotation').addEventListener('click', () => {
            autoRotate = !autoRotate;
        });

        window.addEventListener('resize', () => {
            const width = container.clientWidth;
            const height = container.clientHeight;
            camera.aspect = width / height;
            camera.updateProjectionMatrix();
            renderer.setSize(width, height);
        });

        // 3. Color Range Slider Comparator
        const colorRange = document.getElementById('colorRange');
        const hncsOverlay = document.getElementById('hncsOverlay');
        colorRange.addEventListener('input', (e) => {
            hncsOverlay.style.width = `${e.target.value}%`;
        });

        // 4. Hotspot Information Controller
        const hotspotsData = {
            sensor: {
                title: '100MP BSI Medium Format Sensor',
                desc: 'Sensor BSI berukuran 43.8 x 32.9 mm memberikan resolusi masif dengan rentang dinamis hingga 15 stop.'
            },
            chassis: {
                title: 'Solid CNC Aluminum Monocoque',
                desc: 'Setiap bodi difrais dari satu blok aluminium aero-grade untuk kekuatan struktural presisi mutlak.'
            },
            shutter: {
                title: 'Custom Central Leaf Shutter',
                desc: 'Mekanisme rana dalam lensa yang mampu melakukan sinkronisasi flash penuh pada semua kecepatan hingga 1/4000 detik.'
            }
        };

        function showHotspot(key) {
            const data = hotspotsData[key];
            if (data) {
                document.getElementById('hotspotTitle').innerText = data.title;
                document.getElementById('hotspotDesc').innerText = data.desc;
            }
        }

        // Explode Component Simulation Toggle
        let isExploded = false;
        document.getElementById('toggleExplodeBtn').addEventListener('click', () => {
            isExploded = !isExploded;
            const lens = document.getElementById('hotspotLens');
            const chassis = document.getElementById('hotspotChassis');
            const text = document.getElementById('explodeBtnText');

            if (isExploded) {
                lens.style.transform = 'translateZ(50px) scale(1.1)';
                chassis.style.transform = 'scale(0.95)';
                text.innerText = 'Kembalikan Tampilan Utuh';
            } else {
                lens.style.transform = 'none';
                chassis.style.transform = 'none';
                text.innerText = 'Urai Komponen Optik 3D';
            }
        });

        // 5. Lightbox Controller
        function openLightbox(url, title, artist, cat) {
            document.getElementById('lightboxImg').src = url;
            document.getElementById('lightboxTitle').innerText = title;
            document.getElementById('lightboxArtist').innerText = `Fotografer: ${artist} • ${cat}`;
            document.getElementById('lightbox').classList.remove('hidden');
        }

        function closeLightbox() {
            document.getElementById('lightbox').classList.add('hidden');
        }

        // 6. Specification Tab Swapping
        function switchSpecTab(mode) {
            const studioBtn = document.getElementById('tab-studio');
            const landscapeBtn = document.getElementById('tab-landscape');
            const sensorText = document.getElementById('specSensorText');

            if (mode === 'studio') {
                studioBtn.className = 'px-6 py-3 rounded-xl text-xs uppercase tracking-wider font-mono bg-gold text-black font-bold';
                landscapeBtn.className = 'px-6 py-3 rounded-xl text-xs uppercase tracking-wider font-mono bg-white/5 text-neutral-400 hover:text-white';
                sensorText.innerText = 'Detail mikro sempurna untuk pencetakan komersial ukuran cetak spanduk besar tanpa pikselasi.';
            } else {
                landscapeBtn.className = 'px-6 py-3 rounded-xl text-xs uppercase tracking-wider font-mono bg-gold text-black font-bold';
                studioBtn.className = 'px-6 py-3 rounded-xl text-xs uppercase tracking-wider font-mono bg-white/5 text-neutral-400 hover:text-white';
                sensorText.innerText = 'Resolusi masif menangkap tekstur dedaunan dan bebatuan di kejauhan dengan jernih.';
            }
        }

        // 7. Live Laser Engraving Text Preview Input
        const engravingInput = document.getElementById('engravingInput');
        const engravingPreview = document.getElementById('engravingPreview');

        engravingInput.addEventListener('input', (e) => {
            const val = e.target.value.toUpperCase();
            engravingPreview.innerText = val || 'INISIAL ANDA';
        });
    </script>
