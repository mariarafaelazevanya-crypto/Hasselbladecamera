        <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
            <a href="#hero" class="flex items-center gap-3 group">
                <div class="w-10 h-10 rounded-lg bg-gradient-to-tr from-gold to-amber-200 flex items-center justify-center text-black font-bold font-serif text-xl shadow-lg shadow-gold/20">
                    H
                </div>
                <div class="flex flex-col">
                    <span class="font-serif tracking-widest text-lg font-bold text-white group-hover:text-gold transition-colors">
