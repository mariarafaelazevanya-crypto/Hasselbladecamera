                    </span>
                    <span class="text-[9px] tracking-widest uppercase text-neutral-400 font-mono">
                        SWEDEN 1941
                    </span>
                </div>
            </a>

            <nav class="hidden md:flex items-center gap-8 text-xs uppercase tracking-widest text-neutral-300 font-medium">
                <a href="#medium-format" class="hover:text-gold transition-colors">Medium Format</a>
                <a href="#colour" class="hover:text-gold transition-colors">Natural Colour</a>
                <a href="#precision" class="hover:text-gold transition-colors">Presisi Optik</a>
                <a href="#mastery" class="hover:text-gold transition-colors">Galeri Kurator</a>
                <a href="#specs" class="hover:text-gold transition-colors font-semibold text-white">X2D 100C</a>
            </nav>

            <div class="hidden md:flex items-center gap-4">
                <a href="#concierge" class="px-6 py-2.5 rounded-full bg-gradient-to-r from-gold via-amber-300 to-gold text-black font-medium text-xs tracking-wider uppercase hover:shadow-lg hover:shadow-gold/30 transition-all transform hover:-translate-y-0.5">
                    Private Demo
                </a>
            </div>

            <button id="mobileMenuBtn" class="md:hidden p-2 text-white">
                <i class="fa-solid fa-bars text-xl"></i>
            </button>
        </div>

        <div id="mobileMenu" class="hidden md:hidden bg-[#141416] border-b border-white/10 px-6 py-6 flex flex-col gap-4 text-sm font-medium tracking-wider">
            <a href="#medium-format" class="py-2 border-b border-white/5">Medium Format</a>
            <a href="#colour" class="py-2 border-b border-white/5">Natural Colour</a>
            <a href="#precision" class="py-2 border-b border-white/5">Presisi Optik</a>
            <a href="#mastery" class="py-2 border-b border-white/5">Galeri Kurator</a>
            <a href="#specs" class="py-2 border-b border-white/5">Spesifikasi X2D</a>
